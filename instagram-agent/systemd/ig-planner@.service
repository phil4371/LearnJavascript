[Unit]
Description=Instagram Weekly Planner — %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/instagram-agent
ExecStart=/home/pi/instagram-agent/venv/bin/python runners/run_weekly_planner.py --account %i
StandardOutput=append:/home/pi/instagram-agent/logs/%i.log
StandardError=append:/home/pi/instagram-agent/logs/%i.log
