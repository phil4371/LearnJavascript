# Geteilte API-Keys — diese Datei als .env.shared auf dem Pi speichern
# NIEMALS committen!

# Anthropic (Claude Haiku für Captions, Planer, Replies)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (DALL-E 3 für Bilder)
OPENAI_API_KEY=sk-...

# HuggingFace (kostenloser Fallback für Bilder)
HF_TOKEN=hf_...

# imgbb (Bild-Hosting für Meta API)
IMGBB_API_KEY=...

# Feature-Flags (optional)
# PREFER_FREE_IMAGES=false   # true = immer HuggingFace statt DALL-E (kostenlos, schlechtere Qualität)
# USE_OLLAMA=false           # true = lokales Ollama statt Claude (noch billiger, etwas schlechtere Qualität)
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434
